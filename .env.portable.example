# QRIA portable runtime
NODE_ENV=development
AUTH_MODE=local
LOCAL_USER_OPEN_ID=qria-local-user
LOCAL_USER_NAME=QRIA User
LOCAL_USER_EMAIL=local@qria.app
JWT_SECRET=change-me

# Database
# memory = preview/teste sem infraestrutura externa
# mysql = persistência real com URL MySQL-compatible
DB_MODE=memory
DATABASE_URL=
# Exemplo para produção persistente:
# DB_MODE=mysql
# DATABASE_URL=mysql://user:password@host:3306/qria

# AI provider: openai | compatible | manus
AI_PROVIDER=openai
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.6-terra

# Image provider: openai | compatible | manus
IMAGE_PROVIDER=openai
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2

# Legacy Manus settings are optional and only needed with provider=manus
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OAUTH_SERVER_URL=
VITE_APP_ID=qria
